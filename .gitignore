# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
snapshot/
*.egg-info/
*.egg
.eggs/

# Test / coverage / linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# IDE / editor
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db

# Env / secrets
.env
.env.*
!.env.example
config/db_config.json
config/returned_config.json
config/secrets.json

# Logs & temp
*.log
*.tmp
*.temp
tmp/
temp/
logs/
dist/logs/
runtime/logs/

# Backups
*.bak
*.bak.*

# Excel temp / lock files (Office open)
~$*
*.~*

# Spreadsheet / tabular data（业务数据在桌面与网络盘，勿提交）
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv

# 本机运行时产物（目录用 .gitkeep 占位）
runtime/local/*.json
!runtime/local/.gitkeep

# API 文档抓取缓存
api/_doc_cache/

# Jupyter
.ipynb_checkpoints/
